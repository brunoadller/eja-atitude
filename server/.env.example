# ---- Banco (PostgreSQL) ----
DATABASE_URL="postgresql://eja:senha_forte@localhost:5432/eja"

# ---- Servidor ----
PORT=3000
NODE_ENV=development
# Origem do front em desenvolvimento (Vite). Em produção o Express serve o front, então não é usada.
CLIENT_ORIGIN=http://localhost:5173
# Quantos proxies existem na frente do Express (Render/Railway/Nginx = 1). Em dev deixe 0.
TRUST_PROXY=0

# ---- JWT (OBRIGATÓRIO) ----
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-com-no-minimo-32-caracteres
JWT_EXPIRES_IN=8h

# ---- E-mail (recuperação de senha) ----
# Em desenvolvimento, se SMTP_HOST estiver vazio, o código é mostrado no terminal do servidor.
# Em produção SMTP é obrigatório.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EJA Atitude <nao-responder@seudominio.com.br>"

# ---- Regras da secretaria ----
# 1ª via de atestado/certificado gratuita (a partir da 2ª cobra a taxa). Use false para cobrar sempre.
FIRST_VIA_FREE=true
# Bloqueia o lançamento de prova para aluno com mensalidade vencida/do mês em aberto.
ENFORCE_PAYMENT_FOR_EXAMS=true

# ---- Admin inicial (usado só pelo seed) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
